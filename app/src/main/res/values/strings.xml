    <!-- About & data sources -->
    <string name="about_sources_title">Data sources</string>
    <string name="about_sources_body">Character facts and images come from Comic Vine, and every card and profile says so. When a field is missing from the source, Assemble leaves it out instead of guessing.</string>
    <string name="about_ai_title">AI conversations</string>
    <string name="about_ai_body">Replies in Chat are written by AI as a fictional take on the character. Every reply is labeled \"AI-generated · fictional\". They are not canon and are not approved by the publisher.</string>
    <string name="about_compatibility_title">Compatibility</string>
    <string name="about_compatibility_body">Compatibility is an estimate based on the preferences you chose. It is not a personality judgment. It only appears after you connect, as an exact percentage.</string>
    <string name="about_project_title">This project</string>
    <string name="about_project_body">Assemble is an academic project. The current catalog is Marvel characters.</string>

    <!-- Help -->
    <string name="help_discover_title">How do Pass and Assemble work?</string>
    <string name="help_discover_body">Swipe a card left or tap Pass to skip a character. Swipe right or tap Assemble to show interest. Undo brings back your last Pass.</string>
    <string name="help_match_title">How does a connection happen?</string>
    <string name="help_match_body">Assemble shows your interest. The character decides too: compatibility is one of the factors, so not every Assemble becomes a connection. It is all fiction, never dating.</string>
    <string name="help_chat_title">Are the chats real?</string>
    <string name="help_chat_body">Each connection opens a chat with a fictional, AI-generated version of the character. If a message fails, tap Try again.</string>
    <string name="help_preferences_title">Can I change my preferences?</string>
    <string name="help_preferences_body">Change your preferences in Profile at any time. Your Discover results update right away.</string>

