<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema da janela. Cores e tipografia da UI vêm do AssembleTheme (Compose). -->
    <style name="Theme.Assemble" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Splash Screen API: só o fundo (claro ou escuro, como o tema); o logo é montado pela BrandSplash (Compose) logo em seguida. -->
    <style name="Theme.Assemble.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Assemble</item>
    </style>
</resources>
